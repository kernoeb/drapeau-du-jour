{
  "name": "fotd",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && vite build",
    "build:server": "bun build server/app.ts --compile --minify --sourcemap=inline --outfile server/ddj",
    "dev": "vite",
    "dev-server": "PORT=7059 bun --watch server/app.ts",
    "lint": "eslint src server",
    "preview": "vite preview",
    "server": "bun server/app.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "browser-passworder": "2.0.3",
    "dayjs": "1.11.23",
    "ky": "2.2.0",
    "normalize-diacritics": "5.0.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsparticles/vue3": "4.4.0",
    "@vitejs/plugin-vue": "6.0.10",
    "bun-types": "1.4.3",
    "crypto-browserify": "3.12.1",
    "daisyui": "5.7.50",
    "eslint": "10.13.0",
    "tailwindcss": "4.3.3",
    "tsparticles": "4.4.0",
    "typescript": "6.0.3",
    "unplugin-fonts": "2.0.0",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
